# Include this AFTER the original soot-dem target definitions.
# This module adds targets; it does not replace soot-dem's project or executables.
include_guard(DIRECTORY)
option(SOOT_BUILD_CAPILLARY_COUPLING "Add PF-SPH / soot-dem coupling targets" ON)
if(NOT SOOT_BUILD_CAPILLARY_COUPLING)
  return()
endif()
get_filename_component(_pf_soot_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT EXISTS "${_pf_soot_root}/src/aggregate.h")
  message(FATAL_ERROR "SootCapillaryCoupling.cmake must be installed in soot-dem/cmake")
endif()
if(NOT EXISTS "${_pf_soot_root}/capillary/CMakeLists.txt")
  message(FATAL_ERROR "Missing capillary source subdirectory; run the coupling installer")
endif()
set(PF_WITH_SOOT_DEM ON CACHE BOOL "Build soot-dem force/neck backend" FORCE)
set(SOOT_DEM_SOURCE_DIR "${_pf_soot_root}" CACHE PATH "The containing soot-dem checkout" FORCE)
option(PF_BUILD_SPHINXSYS_VALIDATION "Build historical SPHinXsys validation adapters" OFF)
enable_testing()
add_subdirectory("${_pf_soot_root}/capillary" "${CMAKE_CURRENT_BINARY_DIR}/capillary")
# Keep executable paths consistent with soot-dem's existing build/<target> layout.
get_property(_pf_added_targets DIRECTORY "${_pf_soot_root}/capillary" PROPERTY BUILDSYSTEM_TARGETS)
foreach(_pf_target IN LISTS _pf_added_targets)
  get_target_property(_pf_type "${_pf_target}" TYPE)
  if(_pf_type STREQUAL "EXECUTABLE")
    set_target_properties("${_pf_target}" PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
  endif()
endforeach()
unset(_pf_added_targets)
unset(_pf_target)
unset(_pf_type)
unset(_pf_soot_root)
