<pf_dem>
  <!-- Provisional model units. This is a development case, not calibrated water. -->
  <fluid dx="0.08" rho0="1" sound_speed="10" viscosity="0.05" sff="0.001" sfs="0.003"/>
  <contacts stiffness="100" damping="0.02" friction="0.2" slip_speed="0.01"/>
  <particle x="0" y="0" z="-0.60" radius="0.24" density="2"/>
  <!-- Initially dry particle approaches the liquid along +x. -->
  <particle x="-1.35" y="0" z="0.15" radius="0.24" density="2" vx="0.3" wz="0.2"/>
  <liquid mode="droplets"><droplet x="0" y="0" z="0" radius="0.65"/></liquid>
  <domain margin="0.32" max_samples="2000000"/>
  <run end_time="2" dt_scale="0.75" record_every_steps="100" dump_every_steps="500"
       checkpoint_every_steps="500" threads="6"/>
</pf_dem>
