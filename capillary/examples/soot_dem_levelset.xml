<pf_dem>
  <fluid dx="0.04" rho0="1" sound_speed="10" viscosity="0.05" sff="0.001" sfs="0.003"/>
  <particles file="soot_aggregate.csv" ignore_velocities="true"/>
  <soot_dem k_n="100" gamma_n="0.02" k_t="20" k_r="5" k_o="5"
            k_n_bond="100" gamma_n_bond="0.02" k_t_bond="20" k_r_bond="5" k_o_bond="5"
            d_crit="0.02" A="0" h0="0.01" max_dt="0.0001"/>
  <necks file="soot_necks.csv"/>
  <!-- Threshold > .5 suppresses a coating on an isolated sphere surface. -->
  <liquid mode="levelset" alpha="0.25" threshold="0.6" rm="0.24"/>
  <domain margin="0.32" max_samples="2000000"/>
  <run end_time="0.5" dt_scale="0.75" record_every_steps="100" dump_every_steps="500"
       checkpoint_every_steps="500" threads="6"/>
</pf_dem>
